# PostgreSQL 数据库配置（Docker Compose 使用）
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger_dev_password
POSTGRES_DB=ledger

# 数据库连接（本地直接运行使用，Docker 内部会自动构建）
DATABASE_URL=postgresql://ledger:ledger_dev_password@localhost:5432/ledger

# 会话密钥（使用 python -c "import secrets; print(secrets.token_urlsafe(48))" 生成）
# 注意：这只是示例，实际使用时必须替换为随机生成的密钥
SESSION_SECRET=CHANGE_ME_TO_RANDOM_SECRET

# 应用环境
APP_ENV=dev

# 日志级别
LOG_LEVEL=INFO

# 会话 Cookie 安全设置（生产环境设为 true）
SESSION_COOKIE_SECURE=false

# 是否允许注册（S3 阶段设为 false，用管理员手动创建账号）
REGISTRATION_OPEN=false

# Web 服务端口（Docker Compose 使用）
WEB_PORT=8000

# Worker 并发数
WORKER_CONCURRENCY=2

# 镜像标签
IMAGE_TAG=dev
