# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除。
# 所有占位值都必须替换：应用启动时会校验，占位密钥会被拒绝。

# ---------------------------------------------------------------- 数据库
POSTGRES_USER=ledger
POSTGRES_PASSWORD=
POSTGRES_DB=ledger

# ---------------------------------------------------------------- 应用
# 生成随机密钥：python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# dev | test | staging | prod
APP_ENV=dev
LOG_LEVEL=INFO

# 本地 HTTP 调试时为 false；生产走 HTTPS 必须为 true
SESSION_COOKIE_SECURE=false

# 第一版保持 false：由管理员用 ledger.cli create-admin 建号试用功能。
# 开放注册需要先接通邮箱验证通道。
REGISTRATION_OPEN=false

# ---------------------------------------------------------------- 运行
WEB_PORT=8000
WORKER_CONCURRENCY=2
IMAGE_TAG=dev
